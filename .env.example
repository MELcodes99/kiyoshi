# Required: the agent's hot wallet key (generate a fresh one with: npm run new-wallet)
AGENT_PRIVATE_KEY=
# Optional: Celo RPC (defaults to https://forno.celo.org)
CELO_RPC=https://forno.celo.org
# 0 = dry run (scan and log only), 1 = trade real money
LIVE=0
MAX_TRADE_USD=100
MIN_EDGE_USD=0.01
INTERVAL_SEC=60
MAX_FLATTEN_LOSS_BPS=50
MAX_HOLD_MIN=30
PORT=3000
DATA_DIR=.
